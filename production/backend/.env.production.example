# Railway fills this automatically when a PostgreSQL database is attached.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-64-hex-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Replace with the real Vercel frontend URL after frontend deployment.
ALLOWED_ORIGINS=https://trickee-platform.vercel.app

MODEL_DIR=models_ml
DEMO_SEED=false
DEMO_ADMIN_PASSWORD=
DEMO_FLEET_PASSWORD=
DEMO_DRIVER_PASSWORD=
PORT=8000

# Optional V5/V5-D integrations. Endpoints work with fallback logic without these.
OPENWEATHER_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
EXTERNAL_API_TIMEOUT_SECONDS=6

# Weekly report generation. Leave GROQ_API_KEY blank for deterministic fallback.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
RESEND_API_KEY=
REPORT_FROM_EMAIL=
REPORT_TO_EMAILS=
REDIS_URL=

NOTIFICATION_PROVIDER=dashboard
NOTIFICATION_WEBHOOK_URL=

FIREBASE_AUTH_ENABLED=false
FIREBASE_FCM_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
