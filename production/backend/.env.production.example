# Railway fills this automatically when a PostgreSQL database is attached.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-64-hex-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Replace with the real Vercel frontend URL after frontend deployment.
ALLOWED_ORIGINS=https://trickee-evify-live.vercel.app
ENVIRONMENT=production
MAX_REQUEST_BODY_BYTES=2000000
GLOBAL_RATE_LIMIT_PER_MINUTE=600
AUTH_RATE_LIMIT_PER_MINUTE=20
TELEMETRY_RATE_LIMIT_PER_MINUTE=120
INTELLIGENCE_RATE_LIMIT_PER_MINUTE=90
AI_RATE_LIMIT_PER_MINUTE=20
WEBSOCKET_TICKET_RATE_LIMIT_PER_MINUTE=30
SUPABASE_JWT_SECRET=
SUPABASE_URL=https://<YOUR_PROJECT_REF>.supabase.co
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
LEGACY_AUTH_ENABLED=false
AUTH_REQUIRED_PROVIDER=google
GOOGLE_OAUTH_CLIENT_IDS=web-client-id.apps.googleusercontent.com,android-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_HOSTED_DOMAIN=
REFRESH_TOKEN_EXPIRE_DAYS=30

MODEL_DIR=models_ml
DEMO_SEED=false
DEMO_ADMIN_PASSWORD=
DEMO_FLEET_PASSWORD=
DEMO_DRIVER_PASSWORD=
PORT=8000

# Optional V5/V5-D integrations. Endpoints work with fallback logic without these.
OPENWEATHER_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
EXTERNAL_API_TIMEOUT_SECONDS=6
EXTERNAL_CONTEXT_REDIS_CACHE_ENABLED=true
EXTERNAL_CONTEXT_STALE_CACHE_SECONDS=86400
EXTERNAL_CONTEXT_H3_ENABLED=true
EXTERNAL_CONTEXT_H3_RESOLUTION=10
EXTERNAL_CONTEXT_WEATHER_H3_RESOLUTION=6
GOOGLE_EXTERNAL_DAILY_LIMIT=1500
OPENWEATHER_EXTERNAL_DAILY_LIMIT=1000

# AI model provider. Gemini is primary for Google-tech-first submission.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Keep GROQ as optional fallback provider.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
AI_REQUEST_TIMEOUT_SECONDS=4
AI_MAX_RETRIES=1
AI_MAX_INPUT_CHARS=4000
AI_MAX_OUTPUT_TOKENS=220
ASSISTANT_RATE_LIMIT_PER_HOUR=20
NOTIFICATION_PERSONALIZATION_RATE_LIMIT_PER_HOUR=10
CHARGER_RECOMMENDATION_RATE_LIMIT_PER_HOUR=30
ROUTE_EXPLANATION_RATE_LIMIT_PER_HOUR=30
FLEET_SUMMARY_RATE_LIMIT_PER_HOUR=20
COACHING_RATE_LIMIT_PER_DAY=10
RESEND_API_KEY=
REPORT_FROM_EMAIL=
REPORT_TO_EMAILS=
REDIS_URL=
LIVE_STATE_REDIS_ENABLED=true
LIVE_STATE_TTL_SECONDS=300

NOTIFICATION_PROVIDER=dashboard
NOTIFICATION_WEBHOOK_URL=

FIREBASE_AUTH_ENABLED=false
FIREBASE_FCM_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
